{
  "name": "readshelf-book-review",
  "version": "1.0.0",
  "private": true,
  "description": "Local full-stack Book Review project",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "tailwindcss": "4.1.18",
    "@tailwindcss/cli": "4.1.18"
  }
}
